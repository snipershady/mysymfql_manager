<form method="post" action="{{ path('app_sql_client_delete', {'id': sql_client.id}) }}"
      {{ stimulus_controller('confirm', {message: 'Eliminare definitivamente il server ' ~ sql_client.host ~ '?'}) }} {{ stimulus_action('confirm', 'ask', 'submit') }}>
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ sql_client.id) }}">
    <button type="submit" class="btn btn-danger btn-sm">
        <i class="fa-solid fa-trash me-1"></i>Elimina
    </button>
</form>
