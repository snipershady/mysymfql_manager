{% set current_server_name = form.sqlClient.vars.data ? form.sqlClient.vars.data.name : '' %}
{% set current_db_name = form.dbName.vars.value ?? '' %}

<div {{ stimulus_controller('database-picker', {url: path('app_show_databases_get_data'), currentServer: current_server_name, currentDb: current_db_name}) }}>
{{ form_start(form) }}

{# ── Server ── #}
<div class="mb-3">
    {{ form_label(form.sqlClient, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
    {{ form_widget(form.sqlClient, {attr: {class: 'form-select', 'data-database-picker-target': 'server', 'data-action': 'change->database-picker#serverChanged'}}) }}
    {{ form_errors(form.sqlClient) }}
</div>

{# ── Database (select visibile UI-only + hidden widget Symfony per il binding) ── #}
<div class="mb-3" id="db-name-group" {{ stimulus_target('database-picker', 'group') }}{% if not current_server_name %} hidden{% endif %}>
    <label for="select-db-name" class="form-label fw-semibold">
        Nome database <span class="text-danger">*</span>
    </label>
    {# Select visibile — nessun name, aggiorna il campo hidden sotto #}
    <select id="select-db-name" class="form-select" {{ stimulus_target('database-picker', 'select') }} {{ stimulus_action('database-picker', 'sync', 'change') }}>
        {% if current_db_name %}
            <option value="{{ current_db_name }}" selected>{{ current_db_name }}</option>
        {% else %}
            <option value="">— Seleziona prima un server —</option>
        {% endif %}
    </select>
    {{ form_errors(form.dbName) }}
    {# Widget Symfony nascosto — riceve il valore dal select (controller database-picker) #}
    {{ form_widget(form.dbName, {attr: {class: 'd-none', tabindex: '-1', 'data-database-picker-target': 'field'}}) }}
</div>

{# ── Proprietario ── #}
<div class="mb-3">
    {{ form_label(form.owner, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
    {{ form_widget(form.owner) }}
    {{ form_errors(form.owner) }}
</div>

<div class="d-flex gap-2">
    <button type="submit" class="btn btn-primary">
        <i class="fa-solid fa-floppy-disk me-1"></i>{{ button_label|default('Salva') }}
    </button>
    <a href="{{ path('app_database_owner_index') }}" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i>Annulla
    </a>
</div>

{{ form_end(form) }}
</div>
