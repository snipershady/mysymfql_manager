{# Header of a cockpit: title, overall state, last refresh, refresh controls. #}
<div class="card mb-3">
    <div class="card-body d-flex flex-wrap align-items-center gap-3 py-2">
        <span class="fs-5"><i class="fa-solid {{ icon }} text-secondary me-2"></i><span class="font-monospace">{{ title }}</span></span>
        <span id="cockpit-severity" {{ stimulus_target(controller, 'severity') }}></span>
        <span class="text-muted small" id="cockpit-updated" {{ stimulus_target(controller, 'updated') }}></span>
        <div class="ms-auto d-flex align-items-center gap-2">
            <label class="form-check form-switch mb-0 small">
                <input class="form-check-input" type="checkbox" checked {{ stimulus_target(controller, 'auto') }} {{ stimulus_action(controller, 'toggle', 'change') }}>
                <span class="form-check-label">Aggiornamento automatico</span>
            </label>
            <select class="form-select form-select-sm w-auto" aria-label="Intervallo di aggiornamento" {{ stimulus_target(controller, 'interval') }} {{ stimulus_action(controller, 'toggle', 'change') }}>
                <option value="5">5 s</option>
                <option value="15" selected>15 s</option>
                <option value="60">60 s</option>
            </select>
            <button type="button" class="btn btn-sm btn-outline-primary" {{ stimulus_action(controller, 'refresh') }}>
                <i class="fa-solid fa-rotate me-1"></i>Aggiorna
            </button>
        </div>
    </div>
</div>
