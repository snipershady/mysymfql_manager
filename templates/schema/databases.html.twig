{% extends 'layouts/admin.html.twig' %}

{% block title %}Database{% endblock %}
{% block page_title %}Database{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item active">Database</li>
{% endblock %}

{% block content %}
<div {{ stimulus_controller('databases', {urls: {
    databases: path('app_show_databases_get_data'),
    tables: path('app_schema_tables'),
    create: path('app_schema_create_database'),
    drop: path('app_schema_drop_database'),
    backup: path('app_schema_table_backup'),
    enqueue: path('app_schema_enqueue_backup'),
}}) }}>

{# ── Modal crea database ── #}
<div class="modal fade" id="modal-create-db" tabindex="-1" aria-labelledby="modal-create-db-label" aria-hidden="true" {{ stimulus_target('databases', 'modal') }} {{ stimulus_action('databases', 'resetForm', 'hidden.bs.modal') }}>
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-create-db-label">
                    <i class="fa-solid fa-plus-circle text-success me-2"></i>Crea nuovo database
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">

                {# Database #}
                <h6 class="text-uppercase text-muted fw-semibold small mb-3">
                    <i class="fa-solid fa-database me-1"></i>Database
                </h6>
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label for="create-db-name" class="form-label">Nome database <span class="text-danger">*</span></label>
                        <input type="text" id="create-db-name" class="form-control font-monospace" {{ stimulus_target('databases', 'dbName') }}
                               placeholder="my_database" pattern="^\w+$"
                               title="Solo caratteri alfanumerici e underscore" required>
                    </div>
                    <div class="col-md-4">
                        <label for="create-db-charset" class="form-label">Charset</label>
                        <select id="create-db-charset" class="form-select" {{ stimulus_target('databases', 'charset') }}>
                            {% for cs in charsets %}
                                <option value="{{ cs.value }}"{% if cs.value == 'utf8mb4' %} selected{% endif %}>
                                    {{ cs.value }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label for="create-db-collation" class="form-label">Collation</label>
                        <select id="create-db-collation" class="form-select" {{ stimulus_target('databases', 'collation') }}>
                            {% for col in collations %}
                                <option value="{{ col.value }}"{% if col.value == 'utf8mb4_0900_ai_ci' %} selected{% endif %}>
                                    {{ col.value }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                </div>

                <hr>

                {# Utente #}
                <h6 class="text-uppercase text-muted fw-semibold small mb-1">
                    <i class="fa-solid fa-user me-1"></i>Utente <span class="text-muted fw-normal">(opzionale)</span>
                </h6>
                <p class="text-muted small mb-3">Lascia vuoto il nome utente per creare solo il database.</p>
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label for="create-db-username" class="form-label">Nome utente</label>
                        <input type="text" id="create-db-username" class="form-control font-monospace" {{ stimulus_target('databases', 'username') }}
                               placeholder="db_user" autocomplete="off">
                    </div>
                    <div class="col-md-4">
                        <label for="create-db-password" class="form-label">Password</label>
                        <div class="input-group" {{ stimulus_controller('password-toggle') }}>
                            <input type="password" id="create-db-password" class="form-control font-monospace" {{ stimulus_target('databases', 'password') }} {{ stimulus_target('password-toggle', 'input') }}
                                   placeholder="••••••••" autocomplete="new-password">
                            <button class="btn btn-outline-secondary" type="button" id="btn-toggle-pw" {{ stimulus_action('password-toggle', 'toggle') }}
                                    title="Mostra/Nascondi">
                                <i class="fa-solid fa-eye" {{ stimulus_target('password-toggle', 'icon') }}></i>
                            </button>
                        </div>
                    </div>
                    <div class="col-md-4">
                        {{ include('schema/_host_choice.html.twig', {prefix: 'create-db', parent_controller: 'databases'}) }}
                    </div>
                </div>

                {# Privilegi #}
                <div id="section-privileges">
                    {{ include('schema/_privileges.html.twig', {prefix: 'create-db', parent_controller: 'databases'}) }}
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
                <button type="button" id="btn-create-db-submit" class="btn btn-success" {{ stimulus_target('databases', 'submit') }} {{ stimulus_action('databases', 'create') }}>
                    <i class="fa-solid fa-plus me-1"></i>Crea database
                </button>
            </div>
        </div>
    </div>
</div>

{# ── Selezione server ── #}
<div class="card mb-3">
    <div class="card-header d-flex align-items-center justify-content-between gap-2">
        <span><i class="fa-solid fa-server text-primary me-1"></i>Seleziona server</span>
        <div class="d-flex gap-2">
            {% if is_granted('ROLE_ADMIN') %}
            <a id="btn-open-server-cockpit" href="#" data-path="{{ path('app_schema_server_cockpit') }}" {{ stimulus_target('databases', 'serverLink') }} class="btn btn-sm btn-outline-primary disabled">
                <i class="fa-solid fa-chart-line me-1"></i>Cockpit
            </a>
            <a id="btn-open-engine-status" href="#" data-path="{{ path('app_schema_engine_status') }}" {{ stimulus_target('databases', 'serverLink') }} class="btn btn-sm btn-outline-info disabled">
                <i class="fa-solid fa-gauge-high me-1"></i>Engine Status
            </a>
            {% endif %}
            <a id="btn-open-process-list" href="#" data-path="{{ path('app_schema_process_list') }}" {{ stimulus_target('databases', 'serverLink') }} class="btn btn-sm btn-outline-secondary disabled">
                <i class="fa-solid fa-list me-1"></i>Process List
            </a>
            <a id="btn-open-transactions" href="#" data-path="{{ path('app_schema_transactions') }}" {{ stimulus_target('databases', 'serverLink') }} class="btn btn-sm btn-outline-secondary disabled">
                <i class="fa-solid fa-right-left me-1"></i>Transaction
            </a>
            <a href="#" data-path="{{ path('app_schema_db_users') }}" {{ stimulus_target('databases', 'serverLink') }} class="btn-open-users btn btn-sm btn-outline-secondary disabled">
                <i class="fa-solid fa-users me-1"></i>Utenti MySQL
            </a>
            <button id="btn-open-create-db" class="btn btn-sm btn-success" disabled {{ stimulus_target('databases', 'createButton') }}
                    data-bs-toggle="modal" data-bs-target="#modal-create-db">
                <i class="fa-solid fa-plus me-1"></i>Crea database
            </button>
        </div>
    </div>
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label for="select-sql-client" class="form-label fw-semibold">Server SQL</label>
                <select id="select-sql-client" class="form-select" {{ stimulus_target('databases', 'select') }} {{ stimulus_action('databases', 'serverChanged', 'change') }}>
                    <option value="">— Seleziona un server —</option>
                    {% for client in sql_clients %}
                        <option value="{{ client.name }}"{% if client.name == selected_name %} selected{% endif %}>{{ client.name }} — {{ client.host }}:{{ client.port }}</option>
                    {% else %}
                        <option disabled>Nessun server configurato</option>
                    {% endfor %}
                </select>
            </div>
        </div>
    </div>
</div>

<div class="card" id="card-databases" hidden {{ stimulus_target('databases', 'card') }}>
    <div class="card-header d-flex align-items-center justify-content-between gap-2">
        <span>
            <i class="fa-solid fa-database text-primary me-1"></i>
            Elenco database
            <span id="badge-db-version" class="badge bg-secondary ms-1" hidden {{ stimulus_target('databases', 'versionBadge') }}></span>
        </span>
        <a href="#" data-path="{{ path('app_schema_db_users') }}" {{ stimulus_target('databases', 'serverLink') }} class="btn-open-users btn btn-sm btn-outline-secondary disabled">
            <i class="fa-solid fa-users me-1"></i>Utenti MySQL
        </a>
    </div>
    <div class="card-body">
        <table id="table-databases" class="table table-hover align-middle w-100" {{ stimulus_target('databases', 'table') }}>
            <thead class="table-light">
                <tr>
                    <th>Nome database</th>
                    <th class="cw-110">Tabelle</th>
                    <th class="cw-120">Dimensione</th>
                    <th class="text-end cw-240">Azioni</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>
</div>
{% endblock %}
