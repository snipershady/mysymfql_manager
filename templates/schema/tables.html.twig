{% extends 'layouts/admin.html.twig' %}

{% block title %}Tabelle — {{ db_name }}{% endblock %}
{% block page_title %}Tabelle database{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_schema_databases') }}">Database</a></li>
    <li class="breadcrumb-item active">{{ db_name }}</li>
{% endblock %}

{% block content %}
<div {{ stimulus_controller('tables', {name: name, db: db_name, urls: {
    tables: path('app_show_tables_get_data'),
    backup: path('app_schema_table_backup'),
    enqueue: path('app_schema_enqueue_backup'),
    restore: path('app_schema_table_restore'),
    empty: path('app_schema_table_empty'),
    drop: path('app_schema_table_drop'),
    optimize: path('app_table_optimize'),
    showCreate: path('app_table_show_create'),
}}) }}>


<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between gap-2">
        <span>
            <i class="fa-solid fa-table text-primary me-1"></i>
            Tabelle di <strong>{{ db_name }}</strong>
            <span class="text-muted small ms-2">{{ name }}</span>
            {% if db_version %}
                <span class="badge bg-secondary ms-2">
                    <i class="fa-solid fa-code-branch me-1"></i>MySQL {{ db_version }}
                </span>
            {% endif %}
        </span>
        <div class="d-flex gap-2">
            <a href="{{ path('app_schema_query', {name: name, db_name: db_name}) }}"
               class="btn btn-sm btn-outline-primary">
                <i class="fa-solid fa-terminal me-1"></i>Esegui Query
            </a>
            <a href="{{ path('app_schema_table_restore', {name: name, db_name: db_name}) }}"
               class="btn btn-sm btn-outline-warning">
                <i class="fa-solid fa-cloud-arrow-up me-1"></i>Ripristina da backup
            </a>
            <a href="{{ path('app_schema_databases') }}" class="btn btn-sm btn-outline-secondary">
                <i class="fa-solid fa-arrow-left me-1"></i>Torna ai database
            </a>
        </div>
    </div>
    <div class="card-body">
        <table id="table-tables" class="table table-hover align-middle w-100" {{ stimulus_target('tables', 'table') }}>
            <thead class="table-light">
                <tr>
                    <th>Nome tabella</th>
                    <th>Engine</th>
                    <th>Collation</th>
                    <th class="text-end">Record</th>
                    <th class="text-end">Dim. (MB)</th>
                    <th class="text-end">Libero (MB)</th>
                    <th class="text-end">Auto Inc.</th>
                    <th>Ultima modifica</th>
                    <th>Commento</th>
                    <th class="text-end cw-230">Azioni</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

{# Modale Show Create Table #}
<div class="modal fade" id="modalShowCreate" tabindex="-1" aria-labelledby="modalShowCreateLabel" aria-hidden="true" {{ stimulus_target('tables', 'modal') }}>
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalShowCreateLabel">
                    <i class="fa-solid fa-code me-2 text-primary"></i>Show Create Table — <span id="modalShowCreateTableName" {{ stimulus_target('tables', 'modalTitle') }}></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="modalShowCreateSpinner" class="text-center py-4" {{ stimulus_target('tables', 'modalSpinner') }}>
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Caricamento…</span>
                    </div>
                </div>
                <pre id="modalShowCreateContent" class="d-none bg-light border rounded p-3 ddl-pre" {{ stimulus_target('tables', 'modalContent') }}></pre>
                <div id="modalShowCreateError" class="d-none alert alert-danger" {{ stimulus_target('tables', 'modalError') }}>
                    <i class="fa-solid fa-circle-xmark me-2"></i>Errore nel caricamento della struttura.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" id="btnCopyDdl" class="btn btn-outline-secondary btn-sm" {{ stimulus_target('tables', 'copyButton') }} {{ stimulus_action('tables', 'copyDdl') }}>
                    <i class="fa-solid fa-copy me-1"></i>Copia DDL
                </button>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Chiudi</button>
            </div>
        </div>
    </div>
</div>
</div>
{% endblock %}
