{% extends 'layouts/admin.html.twig' %}

{% block title %}Elenco Backup{% endblock %}
{% block page_title %}Backup{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_schema_databases') }}">Database</a></li>
    <li class="breadcrumb-item active">Elenco Backup</li>
{% endblock %}

{% block content %}
<div {{ stimulus_controller('backup-list', {deleteUrl: path('app_schema_backup_delete')}) }}>


<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between gap-2">
        <span>
            <i class="fa-solid fa-cloud-arrow-down text-primary me-1"></i>
            Backup disponibili
            <span class="badge bg-secondary ms-1">{{ backups|length }}</span>
        </span>
        <a href="{{ path('app_schema_databases') }}" class="btn btn-sm btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i>Torna ai database
        </a>
    </div>
    <div class="card-body">
        {% if backups is empty %}
            <div class="text-center text-muted py-5">
                <i class="fa-solid fa-box-open fa-3x mb-3"></i>
                <p class="mb-0">Nessun file di backup presente.</p>
            </div>
        {% else %}
            <table id="table-backups" class="table table-hover align-middle w-100 table-compact" {{ stimulus_target('backup-list', 'table') }}>
                <thead class="table-light">
                    <tr>
                        <th>File</th>
                        <th class="cw-140">Dimensione</th>
                        <th class="cw-190">Data</th>
                        <th class="text-end cw-100">Azioni</th>
                    </tr>
                </thead>
                <tbody>
                    {% for backup in backups %}
                    <tr class="backup-row cursor-pointer" {{ stimulus_action('backup-list', 'open') }}
                        data-filename="{{ backup.id }}"
                        data-view-url="{{ path('app_schema_backup_view') }}?filename={{ backup.id|url_encode }}">
                        <td>
                            <i class="fa-solid fa-file-code text-muted me-2"></i>
                            <span class="font-monospace">{{ backup.filename }}</span>
                            {% if backup.dbName is not null %}<span class="badge text-bg-light border ms-2">#{{ backup.sqlClientId }} · {{ backup.dbName }}</span>{% else %}<span class="badge text-bg-warning ms-2" title="Backup in formato precedente: server non determinabile, visibile solo agli admin">legacy</span>{% endif %}
                        </td>
                        <td class="text-muted">
                            {% set kb = (backup.size / 1024)|round(1) %}
                            {% if kb >= 1024 %}
                                {{ (kb / 1024)|round(2) }} MB
                            {% else %}
                                {{ kb }} KB
                            {% endif %}
                        </td>
                        <td class="text-muted">{{ backup.mtime|date('d/m/Y H:i:s') }}</td>
                        <td class="text-end">
                            <a href="{{ path('app_schema_backup_download') }}?filename={{ backup.id|url_encode }}" data-turbo="false"
                               class="btn btn-sm btn-outline-primary btn-download me-1"
                               title="Scarica backup">
                                <i class="fa-solid fa-download"></i>
                            </a>
                            <button class="btn btn-sm btn-outline-danger btn-delete" {{ stimulus_action('backup-list', 'delete') }}
                                    data-filename="{{ backup.id }}"
                                    title="Elimina backup">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
</div>
</div>
{% endblock %}
