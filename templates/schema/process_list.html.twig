{% extends 'layouts/admin.html.twig' %}

{% block title %}Process List — {{ name }}{% endblock %}
{% block page_title %}Process List{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_schema_databases') }}">Database</a></li>
    <li class="breadcrumb-item active">Process List</li>
{% endblock %}

{% block content %}
<div {{ stimulus_controller('process-list', {name: name, dataUrl: path('app_show_processlist_get_data'), killUrl: path('app_schema_kill_process')}) }}>


{# ── Kill by PID ── #}
<div class="card mb-3">
    <div class="card-header d-flex align-items-center gap-2">
        <i class="fa-solid fa-skull-crossbones text-danger me-1"></i>
        Termina processo per PID
    </div>
    <div class="card-body">
        <div class="d-flex gap-2 align-items-end mw-360">
            <div class="flex-grow-1">
                <label for="kill-pid-input" class="form-label">Process ID</label>
                <input type="number" id="kill-pid-input" class="form-control font-monospace" {{ stimulus_target('process-list', 'pid') }}
                       placeholder="es. 42" min="1">
            </div>
            <button id="btn-kill-pid" class="btn btn-danger mb-0" {{ stimulus_action('process-list', 'killTyped') }}>
                <i class="fa-solid fa-stop me-1"></i>Kill
            </button>
        </div>
    </div>
</div>

{# ── Process list ── #}
<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between gap-2">
        <span>
            <i class="fa-solid fa-list text-primary me-1"></i>
            Process List &mdash; <span class="text-muted small">{{ name }}</span>
        </span>
        <div class="d-flex gap-2">
            <button id="btn-refresh" class="btn btn-sm btn-outline-secondary" {{ stimulus_action('process-list', 'refresh') }}>
                <i class="fa-solid fa-rotate-right me-1"></i>Aggiorna
            </button>
            <a href="{{ path('app_schema_databases') }}" class="btn btn-sm btn-outline-secondary">
                <i class="fa-solid fa-arrow-left me-1"></i>Torna ai database
            </a>
        </div>
    </div>
    <div class="card-body">
        <table id="table-processlist" class="table table-hover align-middle w-100 table-compact" {{ stimulus_target('process-list', 'table') }}>
            <thead class="table-light">
                <tr>
                    <th class="cw-70">PID</th>
                    <th>Utente</th>
                    <th>Host</th>
                    <th>Database</th>
                    <th>Comando</th>
                    <th class="cw-70">Tempo (s)</th>
                    <th>Stato</th>
                    <th>Query</th>
                    <th class="text-end cw-90">Azioni</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>
</div>
{% endblock %}
