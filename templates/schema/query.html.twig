{% extends 'layouts/admin.html.twig' %}

{% block title %}Query SQL — {{ db_name }}{% endblock %}
{% block page_title %}Query SQL{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_schema_databases') }}">Database</a></li>
    <li class="breadcrumb-item"><a href="{{ path('app_schema_tables', {name: name, db_name: db_name}) }}">{{ db_name }}</a></li>
    <li class="breadcrumb-item active">Query SQL</li>
    {% endblock %}

{% block head_extra %}
    {{ parent() }}
{% endblock %}

{% block content %}
<div {{ stimulus_controller('query', {name: name, db: db_name, columnsUrl: path('app_schema_columns_get_data', {name: name, db_name: db_name}), executeUrl: path('app_schema_query_execute'), historyUrl: path('app_schema_query_history', {name: name, db_name: db_name})}) }}>


    <div class="row g-3">
        <div class="col-lg-3">
            <div class="card">
                <div class="card-header">
                    <i class="fa-solid fa-table text-primary me-1"></i>Tabelle
                </div>
                <div id="query-tables-list" class="list-group list-group-flush query-tables-list" {{ stimulus_target('query', 'tables') }}>
                    <div class="list-group-item text-muted small">
                        <i class="fa-solid fa-spinner fa-spin me-1"></i>Caricamento…
                    </div>
                </div>
            </div>
            <div class="card mt-3">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <span><i class="fa-solid fa-clock-rotate-left text-primary me-1"></i>Storico</span>
                    <span class="text-muted small" title="Le tue query su questo database, dall'audit log (ultimi 90 giorni, password oscurate)">le tue query</span>
                </div>
                <div id="query-history-list" class="list-group list-group-flush query-tables-list" {{ stimulus_target('query', 'history') }}>
                    <div class="list-group-item text-muted small">
                        <i class="fa-solid fa-spinner fa-spin me-1"></i>Caricamento…
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="card mb-3">
                <div class="card-header d-flex align-items-center justify-content-between gap-2">
                    <span>
                        <i class="fa-solid fa-terminal text-primary me-1"></i>
                        Query SQL su <strong>{{ db_name }}</strong>
                        <span class="text-muted small ms-2">{{ name }}</span>
                    </span>
                    <div class="d-flex gap-2">
                        <a href="{{ path('app_schema_tables', {name: name, db_name: db_name}) }}" class="btn btn-sm btn-outline-secondary">
                            <i class="fa-solid fa-table me-1"></i>Torna alle tabelle
                        </a>
                        <a href="{{ path('app_schema_databases') }}" class="btn btn-sm btn-outline-secondary">
                            <i class="fa-solid fa-arrow-left me-1"></i>Torna ai database
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <textarea id="sql-editor" {{ stimulus_target('query', 'editor') }} class="form-control font-monospace fs-small-09" rows="10" spellcheck="false"
                             
                              placeholder="SELECT * FROM ..."></textarea>
                    <div class="d-flex align-items-center justify-content-between mt-2">
                        <span class="text-muted small">Suggerimento: Ctrl+Invio (⌘+Invio su Mac) per eseguire.</span>
                        <div class="btn-group">
                            <button type="button" id="btn-explain-query" class="btn btn-outline-secondary" data-prefix="EXPLAIN" {{ stimulus_target('query', 'button') }} {{ stimulus_action('query', 'explain') }}>
                                <i class="fa-solid fa-diagram-project me-1"></i>Explain
                            </button>
                            <button type="button" id="btn-explain-analyze-query" class="btn btn-outline-secondary" data-prefix="EXPLAIN ANALYZE" {{ stimulus_target('query', 'button') }} {{ stimulus_action('query', 'explainAnalyze') }}>
                                <i class="fa-solid fa-magnifying-glass-chart me-1"></i>Explain Analyze
                            </button>
                            <button type="button" id="btn-run-query" class="btn btn-primary" data-prefix="" {{ stimulus_target('query', 'button') }} {{ stimulus_action('query', 'execute') }}>
                                <i class="fa-solid fa-play me-1"></i>Esegui
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="query-result-alert" class="alert d-none mt-3" role="alert" {{ stimulus_target('query', 'alert') }}></div>

    <div id="query-result-card" class="card d-none mt-3" {{ stimulus_target('query', 'card') }}>
        <div class="card-header d-flex align-items-center justify-content-between gap-2">
            <span><i class="fa-solid fa-table-list text-primary me-1"></i>Risultati</span>
            <div class="d-flex align-items-center gap-2">
                <span id="query-result-count" class="badge bg-secondary" {{ stimulus_target('query', 'count') }}></span>
                <div class="btn-group btn-group-sm" role="group" aria-label="Esporta il risultato">
                    <button type="button" id="btn-export-csv" class="btn btn-outline-secondary" title="Scarica il risultato in CSV" {{ stimulus_target('query', 'export') }} {{ stimulus_action('query', 'exportCsv') }}>
                        <i class="fa-solid fa-file-csv me-1"></i>CSV
                    </button>
                    <button type="button" id="btn-export-json" class="btn btn-outline-secondary" title="Scarica il risultato in JSON" {{ stimulus_target('query', 'export') }} {{ stimulus_action('query', 'exportJson') }}>
                        <i class="fa-solid fa-file-code me-1"></i>JSON
                    </button>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div id="query-result-table-wrap" class="table-responsive" {{ stimulus_target('query', 'tableWrap') }}>
                <table id="query-result-table" class="table table-hover table-bordered align-middle w-100 mb-0" {{ stimulus_target('query', 'resultTable') }}>
                    <thead class="table-light"><tr></tr></thead>
                    <tbody></tbody>
                </table>
            </div>
            <pre id="query-result-pre" class="d-none bg-body-tertiary p-3 rounded mb-0 query-result-pre" {{ stimulus_target('query', 'pre') }}></pre>
        </div>
    </div>
</div>
{% endblock %}
