{% extends 'layouts/admin.html.twig' %}

{% block title %}Utenti MySQL{% if db_name %} — {{ db_name }}{% endif %}{% endblock %}
{% block page_title %}Utenti MySQL{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_schema_databases') }}">Database</a></li>
    <li class="breadcrumb-item active">Utenti{% if db_name %} — {{ db_name }}{% endif %}</li>
{% endblock %}

{% block content %}
<div {{ stimulus_controller('db-users', {name: name, db: db_name, urls: {
    users: path('app_schema_db_users_get_data'),
    drop: path('app_schema_db_user_drop'),
    create: path('app_schema_db_user_create'),
    password: path('app_schema_db_user_change_password'),
    grants: path('app_schema_db_user_grants_data'),
    grantSave: path('app_schema_db_user_grant_save'),
}}) }}>

{# ── Modal crea utente ── #}
<div class="modal fade" id="modal-create-user" tabindex="-1" aria-labelledby="modal-create-user-label" aria-hidden="true" {{ stimulus_target('db-users', 'createModal') }} {{ stimulus_action('db-users', 'resetCreate', 'hidden.bs.modal') }}>
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-create-user-label">
                    <i class="fa-solid fa-user-plus text-success me-2"></i>Crea nuovo utente
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label for="cu-username" class="form-label">Nome utente <span class="text-danger">*</span></label>
                        <input type="text" id="cu-username" class="form-control font-monospace" {{ stimulus_target('db-users', 'createUsername') }}
                               placeholder="db_user" autocomplete="off" required>
                    </div>
                    <div class="col-md-4">
                        <label for="cu-password" class="form-label">Password <span class="text-danger">*</span></label>
                        <div class="input-group" {{ stimulus_controller('password-toggle') }}>
                            <input type="password" id="cu-password" class="form-control font-monospace" {{ stimulus_target('db-users', 'createPassword') }} {{ stimulus_target('password-toggle', 'input') }}
                                   placeholder="••••••••" autocomplete="new-password">
                            <button class="btn btn-outline-secondary" type="button" id="btn-cu-toggle-pw" title="Mostra/Nascondi" {{ stimulus_action('password-toggle', 'toggle') }}>
                                <i class="fa-solid fa-eye" {{ stimulus_target('password-toggle', 'icon') }}></i>
                            </button>
                        </div>
                    </div>
                    <div class="col-md-4">
                        {{ include('schema/_host_choice.html.twig', {prefix: 'cu', parent_controller: 'db-users', target: 'createHost'}) }}
                    </div>
                </div>

                <hr>

                <label class="form-label fw-semibold">
                    Privilegi{% if db_name %} su <strong>{{ db_name }}</strong>{% endif %}
                </label>
                {{ include('schema/_privileges.html.twig', {prefix: 'cu', parent_controller: 'db-users', target: 'createPrivileges', label: false}) }}

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
                <button type="button" id="btn-cu-submit" class="btn btn-success" {{ stimulus_target('db-users', 'createSubmit') }} {{ stimulus_action('db-users', 'create') }}>
                    <i class="fa-solid fa-user-plus me-1"></i>Crea utente
                </button>
            </div>
        </div>
    </div>
</div>

{# ── Modal cambio password ── #}
<div class="modal fade" id="modal-change-pw" tabindex="-1" aria-labelledby="modal-change-pw-label" aria-hidden="true" {{ stimulus_target('db-users', 'passwordModal') }}>
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-change-pw-label">
                    <i class="fa-solid fa-key text-warning me-2"></i>Cambia password
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">
                    Utente: <span id="cpw-user-label" class="font-monospace fw-semibold" {{ stimulus_target('db-users', 'passwordUser') }}></span>
                </p>
                <div class="mb-3">
                    <label for="cpw-password" class="form-label">Nuova password <span class="text-danger">*</span></label>
                    <div class="input-group" {{ stimulus_controller('password-toggle') }}>
                        <input type="password" id="cpw-password" class="form-control font-monospace" {{ stimulus_target('db-users', 'newPassword') }} {{ stimulus_target('password-toggle', 'input') }}
                               placeholder="••••••••" autocomplete="new-password">
                        <button class="btn btn-outline-secondary" type="button" id="btn-cpw-toggle-pw" title="Mostra/Nascondi" {{ stimulus_action('password-toggle', 'toggle') }}>
                            <i class="fa-solid fa-eye" {{ stimulus_target('password-toggle', 'icon') }}></i>
                        </button>
                    </div>
                </div>
                <div class="mb-1">
                    <label for="cpw-password-confirm" class="form-label">Conferma password <span class="text-danger">*</span></label>
                    <input type="password" id="cpw-password-confirm" class="form-control font-monospace" {{ stimulus_target('db-users', 'newPasswordConfirm') }}
                           placeholder="••••••••" autocomplete="new-password">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
                <button type="button" id="btn-cpw-submit" class="btn btn-warning" {{ stimulus_target('db-users', 'passwordSubmit') }} {{ stimulus_action('db-users', 'changePassword') }}>
                    <i class="fa-solid fa-key me-1"></i>Aggiorna password
                </button>
            </div>
        </div>
    </div>
</div>

{# ── Modal grant ── #}
<div class="modal fade" id="modal-grant" tabindex="-1" aria-labelledby="modal-grant-label" aria-hidden="true" {{ stimulus_target('db-users', 'grantModal') }}>
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-grant-label">
                    <i class="fa-solid fa-shield-halved text-primary me-2"></i>Gestione Grant
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">


                <p class="text-muted small mb-3">
                    Utente: <span id="grant-user-label" class="font-monospace fw-semibold" {{ stimulus_target('db-users', 'grantUser') }}></span>
                </p>

                <div id="grant-loading" class="text-center py-4" {{ stimulus_target('db-users', 'grantLoading') }}>
                    <i class="fa-solid fa-spinner fa-spin fa-2x text-primary"></i>
                    <p class="text-muted mt-2 small">Caricamento in corso…</p>
                </div>

                <div id="grant-body" hidden {{ stimulus_target('db-users', 'grantBody') }}>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Database disponibili</label>
                        <p class="text-muted small mb-2">
                            Seleziona i database su cui assegnare i privilegi.
                            I database non selezionati perderanno i grant esistenti per questo utente.
                        </p>
                        <div id="grant-db-list" class="border rounded p-2 grant-db-list" {{ stimulus_target('db-users', 'grantDatabases') }}>
                        </div>
                    </div>

                    <hr>

                    <label class="form-label fw-semibold">Privilegi da assegnare ai database selezionati</label>
                    {{ include('schema/_privileges.html.twig', {prefix: 'grant', parent_controller: 'db-users', target: 'grantPrivileges', label: false}) }}

                    <div class="alert alert-warning d-flex align-items-start gap-2 mt-3 mb-0 py-2 small">
                        <i class="fa-solid fa-triangle-exclamation mt-1"></i>
                        <span>
                            Il salvataggio <strong>sostituisce</strong> i grant esistenti sui database selezionati
                            e <strong>revoca</strong> tutti i permessi sui database deselezionati.
                        </span>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
                <button type="button" id="btn-grant-submit" class="btn btn-primary" hidden {{ stimulus_target('db-users', 'grantSubmit') }} {{ stimulus_action('db-users', 'saveGrants') }}>
                    <i class="fa-solid fa-shield-halved me-1"></i>Salva grant
                </button>
            </div>
        </div>
    </div>
</div>

{# ── Card utenti ── #}
<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between gap-2">
        <span>
            <i class="fa-solid fa-users text-primary me-1"></i>
            Utenti MySQL
            {% if db_name %}&mdash; database <strong>{{ db_name }}</strong>{% endif %}
            <span class="text-muted small ms-2">{{ name }}</span>
        </span>
        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-success"
                    data-bs-toggle="modal" data-bs-target="#modal-create-user">
                <i class="fa-solid fa-user-plus me-1"></i>Crea utente
            </button>
            <a href="{{ path('app_schema_databases') }}" class="btn btn-sm btn-outline-secondary">
                <i class="fa-solid fa-arrow-left me-1"></i>Torna ai database
            </a>
        </div>
    </div>
    <div class="card-body">
        <table id="table-users" class="table table-hover align-middle w-100" {{ stimulus_target('db-users', 'table') }}>
            <thead class="table-light">
                <tr>
                    <th>Utente</th>
                    <th>Host</th>
                    {% if db_name %}<th class="cw-130">Grant su DB</th>{% endif %}
                    <th class="cw-120">Account</th>
                    <th class="text-end cw-110">Azioni</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>
</div>
{% endblock %}
