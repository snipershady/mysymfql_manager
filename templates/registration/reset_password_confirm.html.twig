{% extends 'layouts/auth.html.twig' %}

{% block title %}Nuova password{% endblock %}

{% block card_title %}Scegli una nuova password{% endblock %}

{% block content %}
    {{ form_start(form) }}

        <div class="mb-3">
            {{ form_label(form.newPlainPassword.first, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
            {{ form_widget(form.newPlainPassword.first, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.newPlainPassword.first) }}
        </div>

        <div class="mb-4">
            {{ form_label(form.newPlainPassword.second, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
            {{ form_widget(form.newPlainPassword.second, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.newPlainPassword.second) }}
            {{ form_errors(form.newPlainPassword) }}
            <div class="form-text text-muted mt-1">
                <i class="fa-solid fa-info-circle me-1"></i>Almeno 8 caratteri.
            </div>
        </div>

        <div class="d-grid">
            <button type="submit" class="btn btn-primary btn-lg">
                <i class="fa-solid fa-key me-2"></i>Salva la nuova password
            </button>
        </div>

    {{ form_end(form) }}
{% endblock %}

{% block auth_footer %}
    <div class="auth-footer">
        Ricordi la password? <a href="{{ path('app_login') }}">Accedi</a>
    </div>
{% endblock %}
